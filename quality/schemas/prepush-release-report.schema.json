{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/malyarq/burrow/main/quality/schemas/prepush-release-report.schema.json",
  "title": "Burrow pre-push release decision evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "status", "candidate", "quality", "artifacts", "platformSmoke", "authenticity", "knownFailures", "rollback"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportId": { "type": "string", "pattern": "^prepush-[a-f0-9]{64}$" },
    "status": { "const": "passed" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tag", "commit"],
      "properties": {
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
        "tag": { "type": "string", "pattern": "^v" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "quality": { "type": "object", "additionalProperties": false, "required": ["profile", "status"], "properties": { "profile": { "const": "release" }, "status": { "const": "passed" } } },
    "artifacts": { "type": "array", "minItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["path", "platform", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "platform": { "enum": ["darwin", "linux", "win32", "shared"] }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
    "platformSmoke": { "type": "array", "minItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["platform", "status", "artifactSha256", "evidencePath", "signing"], "properties": { "platform": { "enum": ["darwin", "linux", "win32"] }, "status": { "enum": ["passed", "unsupported-runner"] }, "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "evidencePath": { "type": "string", "minLength": 1 }, "signing": { "enum": ["signed", "unsigned", "unavailable"] }, "reason": { "type": "string", "minLength": 1 } } } },
    "authenticity": { "type": "array", "minItems": 3 },
    "knownFailures": { "type": "array", "items": { "type": "string" } },
    "rollback": { "type": "object", "additionalProperties": false, "required": ["immutable", "decision", "permittedActions", "prohibitedActions", "instructions"], "properties": { "immutable": { "const": true }, "decision": { "enum": ["withdraw-or-mark-non-latest", "publish-new-patch"] }, "permittedActions": { "type": "array" }, "prohibitedActions": { "type": "array" }, "instructions": { "type": "string", "pattern": "Never overwrite an existing stable tag or asset" } } }
  }
}
