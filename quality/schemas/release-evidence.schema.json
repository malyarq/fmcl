{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/malyarq/burrow/main/quality/schemas/release-evidence.schema.json",
  "title": "Burrow release integrity and authenticity evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "candidate", "artifacts", "integrity", "authenticity", "packagedSmoke", "rollback", "failures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["passed", "failed"] },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tag", "commit"],
      "properties": {
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
        "tag": { "type": "string", "pattern": "^v" },
        "commit": { "type": "string", "pattern": "^[a-fA-F0-9]{7,40}$" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "platform", "kind", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "platform": { "enum": ["darwin", "linux", "win32", "shared"] },
          "kind": { "enum": ["dmg", "nsis", "appimage", "release-asset"] },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "manifest", "verification", "status"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "manifest": { "const": "SHA256SUMS.txt" },
        "verification": { "const": "clean-verification-directory" },
        "status": { "enum": ["passed", "failed"] }
      }
    },
    "authenticity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "codeSigning", "notarization"],
        "properties": {
          "platform": { "enum": ["darwin", "linux", "win32"] },
          "codeSigning": { "$ref": "#/$defs/authenticityStatus" },
          "notarization": { "$ref": "#/$defs/authenticityStatus" }
        }
      }
    },
    "packagedSmoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidencePath", "artifactSha256"],
      "properties": {
        "status": { "enum": ["passed", "failed", "unsupported-runner", "not-run"] },
        "evidencePath": { "type": ["string", "null"] },
        "artifactSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable", "decision", "permittedActions", "prohibitedActions", "instructions"],
      "properties": {
        "immutable": { "const": true },
        "decision": { "enum": ["withdraw-or-mark-non-latest", "publish-new-patch"] },
        "permittedActions": { "type": "array", "items": { "enum": ["withdraw-or-mark-non-latest", "publish-new-patch"] } },
        "prohibitedActions": { "type": "array", "contains": { "enum": ["overwrite-stable-tag", "overwrite-stable-asset"] } },
        "instructions": { "type": "string", "pattern": "Never overwrite an existing stable tag or asset" }
      }
    },
    "failures": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "authenticityStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked", "reason", "command"],
      "properties": {
        "status": { "enum": ["signed", "notarized", "unsigned", "unavailable"] },
        "checked": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 },
        "command": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["command", "exitCode", "output"],
          "properties": {
            "command": { "type": "string" },
            "exitCode": { "type": "integer" },
            "output": { "type": "string", "maxLength": 4096 }
          }
        }
      }
    }
  }
}
